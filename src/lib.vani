// vani-symbolic  v0.1.0 — expression construction, evaluation, printing
//
// IMPORTANT — do NOT reimplement vāṇī compiler builtins.
// Already available as builtins (call directly, never redeclare here):
//   push len vec i64_to_str clone_at
//
// Production code here is self-contained (no calls into any dep). v0.3.0
// vendors vani-calculus solely for tests/examples' cross-check against
// diff_central -- see [deps] in vani.toml.
//
// ENCODING: flat arena, not a recursive enum. The obvious design --
// `enum Expr { Add(Box<Expr>, Box<Expr>), ... }` -- does NOT compile in
// vāṇī today: enum variants admit only a single payload field in v1 (a
// two-child variant is rejected outright), and box()'s admitted payload
// types exclude anything that transitively contains the type being
// defined (so Box<Expr> inside Expr's own definition is also rejected).
// Confirmed by direct compiler test; see vani-compiler's
// docs/missing_features.md "Recursive / self-referential types" entry.
//
// Workaround, used here: every node lives in a flat Vec<ExprNode> arena,
// referencing its children by i64 index (-1 = none) instead of by
// pointer -- the same "flat Vec + explicit index" convention already
// used by vani-tensor (shape encoding) and vani-sparse (COO/CSR), just
// applied to a tree instead of a matrix. This is a new pattern in this
// ecosystem (no existing package uses a kind-tag-discriminated arena),
// closest in spirit to vani-sparse's struct-of-parallel-Vecs rationale:
// pick a representation that avoids the type system's sharp edges rather
// than fighting them.
//
//   struct ExprNode { kind: i64, value: i64, left: i64, right: i64 }
//   struct SymbolTable { names: Vec<OwnedStr> }
//
// kind tags:  0=Num  1=Var  2=Add  3=Sub  4=Mul  5=Div  6=Pow  7=Neg
// No magic-number consts -- checked vani-bignum/vani-sparse, neither uses
// `const` despite the compiler supporting it; both use raw integer
// literals with an explanatory comment at first use. This table is the
// canonical reference; every construction function names its kind number
// inline.
//
// `value` field reuse: Num's literal and Var's var_id both fit one i64
// slot and never coexist on the same node (a node is exactly one kind),
// so `value` is reused for both rather than adding a second field that
// would sit unused on every non-leaf node. Add/Sub/Mul/Div/Pow/Neg leave
// `value` at 0 (unused). `Neg` is unary: uses `left` for its one child,
// `right` stays -1 -- arity is a pure function of `kind`, never stored
// per-node, so every walker (eval/print/eq) branches on `kind` first and
// only reads the fields that kind's arity defines.
//
// ExprNode IS Copy (four i64 fields, no heap-owning field) -- matches
// vani-complex's Copy-struct pattern, unlike vani-bignum's owned-Vec
// pattern. This means no function ever needs ref/mut ref on an
// individual node -- only on the whole Vec<ExprNode> -- since reading a
// node is a cheap whole-struct copy (`let node: ExprNode = arena[idx];`).
//
// SymbolTable is NOT Copy (owns Vec<OwnedStr>) -- every function takes
// ref/mut ref SymbolTable, matching BigInt's convention. Var.value is a
// dense, 0-based var_id assigned by symtab_intern in first-seen order --
// this is what lets sym_eval substitute variables via a direct
// var_values[var_id] index read, with ZERO string comparison anywhere in
// the evaluation path (string comparison only happens at construction,
// inside symtab_intern, and at print time, inside symtab_name_at).
//
// Vec<OwnedStr> element access: a bare `table.names[i]` read is rejected
// by the checker ("cannot index a Vec whose element type is non-Copy by
// value ... would alias the owner's slot and double-free") -- confirmed
// by direct test. Comparison uses the established `for x in ref xs`
// borrow pattern instead (symtab_intern); an owned copy out of the Vec
// uses the builtin `clone_at(ref xs, i)` (symtab_name_at).
//
// NUMERIC LAYER: v0.1.0 uses plain i64 literals, not vani-bignum's
// BigInt -- matches this ecosystem's narrow-then-widen precedent
// (vani-algebra shipped real-roots-only, vani-discrete shipped
// counting-only). The design already leaves room for BigInt-backed
// numbers later without changing ExprNode's shape: a future phase can
// add a side table `Vec<BigInt>` (parallel to SymbolTable.names) and
// reinterpret Num.value as an index into it rather than a literal. Not
// built now -- YAGNI until a real overflow problem shows up.
//
// POW: v0.1.0 supports nonnegative integer exponents only -- traps via
// assert otherwise, matching this ecosystem's established "assert on
// out-of-scope input" convention (e.g. vani-bignum's bn_div_mod asserts
// the divisor is nonzero rather than silently misbehaving).
//
// STRUCTURAL EQUALITY (sym_eq_structural) is same-SHAPE equality, NOT
// semantic/commutative equality -- 1+2 and 2+1 are NOT equal here.
// Commutative canonicalization is a v0.2 simplification-tier concern.
//
// WCET (MAINT-1 discipline, see kosh-index/ROADMAP.md): every
// #[wcet(cycles=N)] below is vanic check's own exact reported worst-case,
// never hand-derived. Fixed-shape functions (the builders, sym_kind,
// sym_is_leaf, symtab_name_at, the print helpers) get a real
// #[wcet(cycles=N)]. Everything recursive or Vec-length-loop-bounded
// (symtab_intern, sym_eval, _sym_ipow, sym_to_str, sym_eq_structural)
// gets a WCET *formula* comment instead, matching vani-bignum's
// convention for the same reason.

struct ExprNode {
    kind: i64,
    value: i64,
    left: i64,
    right: i64,
}

struct SymbolTable {
    names: Vec<OwnedStr>,
}

// ── Construction ─────────────────────────────────────────────────────────

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 85)]
fn sym_arena_new() -> Vec<ExprNode> {
    return vec();
}

#[bounded_stack(bytes = 88)]
#[wcet(cycles = 89)]
fn symtab_new() -> SymbolTable {
    let names: Vec<OwnedStr> = vec();
    return SymbolTable { names: names };
}

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 36)]
fn sym_num(arena: mut ref Vec<ExprNode>, n: i64) -> i64 {
    push(arena, ExprNode { kind: 0, value: n, left: 0 - 1, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

// Interns `name` (see symtab_intern) and pushes a new Var leaf node
// referencing that var_id. Calling this twice with the same name
// produces two DISTINCT arena nodes sharing one var_id -- both read the
// same slot of var_values at sym_eval time. To reuse one physical
// occurrence (e.g. x*x sharing a single x), reuse the returned node
// index directly instead of calling sym_var again -- see
// examples/symbolic_demo.vani for both patterns side by side.
// NO #[wcet]: calls symtab_intern, whose own cost is a runtime-Vec-
// length-bounded loop.
#[bounded_stack(bytes = 152)]
fn sym_var(arena: mut ref Vec<ExprNode>, table: mut ref SymbolTable, name: Str) -> i64 {
    let var_id: i64 = symtab_intern(table, name);
    push(arena, ExprNode { kind: 1, value: var_id, left: 0 - 1, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

// Returns name's existing var_id if already interned, else appends it
// and returns the new var_id (len-before-push). var_ids are dense,
// 0-based, assigned in first-seen order -- this is what lets sym_eval
// index var_values directly by var_id with no string comparison at eval
// time. Bare `table.names[i]` is rejected by the checker for a non-Copy
// element (would alias + double-free); the confirmed working form is the
// established `for x in ref xs` borrow pattern.
// NO #[wcet]: loop bound is len(table.names), a runtime value.
// WCET formula: ~15 + 10 * len(table.names) (one string-compare per
// existing name, worst case scanning every entry with no match).
#[bounded_stack(bytes = 80)]
fn symtab_intern(table: mut ref SymbolTable, name: Str) -> i64 {
    let i: i64 = 0;
    for existing in ref table.names {
        if existing == name {
            return i;
        }
        i = i + 1;
    }
    push(mut ref table.names, name + "");
    return i;
}

// Owned copy of the display name for var_id. Can't just index-and-return
// (OwnedStr isn't Copy, would alias the Vec's slot) -- clone_at gives an
// explicit, visible-cost deep copy instead.
#[bounded_stack(bytes = 56)]
#[wcet(cycles = 102)]
fn symtab_name_at(table: ref SymbolTable, var_id: i64) -> OwnedStr {
    assert var_id >= 0;
    assert var_id < (len(ref table.names) as i64);
    return clone_at(ref table.names, var_id);
}

// Every binary/unary builder below bounds-checks its child index inline
// (catches a stale/out-of-range index -- e.g. from a different arena --
// at the point of misuse rather than deep inside a later eval/print/eq
// walk). Originally factored into a shared `_sym_check_idx(arena: ref
// Vec<ExprNode>, idx: i64)` helper, but the checker doesn't reborrow a
// `mut ref` binding as `ref` at a call site (confirmed by direct test:
// "argument 1 ... must be assignable to ref Vec<ExprNode>, got mut ref
// Vec<ExprNode>") -- inlined instead, exactly as anticipated as the
// fallback for this case.

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn sym_add(arena: mut ref Vec<ExprNode>, a: i64, b: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    assert b >= 0 && b < (len(arena) as i64);
    push(arena, ExprNode { kind: 2, value: 0, left: a, right: b });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn sym_sub(arena: mut ref Vec<ExprNode>, a: i64, b: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    assert b >= 0 && b < (len(arena) as i64);
    push(arena, ExprNode { kind: 3, value: 0, left: a, right: b });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn sym_mul(arena: mut ref Vec<ExprNode>, a: i64, b: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    assert b >= 0 && b < (len(arena) as i64);
    push(arena, ExprNode { kind: 4, value: 0, left: a, right: b });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn sym_div(arena: mut ref Vec<ExprNode>, a: i64, b: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    assert b >= 0 && b < (len(arena) as i64);
    push(arena, ExprNode { kind: 5, value: 0, left: a, right: b });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn sym_pow(arena: mut ref Vec<ExprNode>, base: i64, exponent: i64) -> i64 {
    assert base >= 0 && base < (len(arena) as i64);
    assert exponent >= 0 && exponent < (len(arena) as i64);
    push(arena, ExprNode { kind: 6, value: 0, left: base, right: exponent });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 48)]
fn sym_neg(arena: mut ref Vec<ExprNode>, a: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    push(arena, ExprNode { kind: 7, value: 0, left: a, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

// ── Introspection ────────────────────────────────────────────────────────

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 10)]
fn sym_kind(arena: ref Vec<ExprNode>, idx: i64) -> i64 {
    return arena[idx].kind;
}

#[bounded_stack(bytes = 57)]
#[wcet(cycles = 22)]
fn sym_is_leaf(arena: ref Vec<ExprNode>, idx: i64) -> bool {
    let k: i64 = arena[idx].kind;
    return k == 0 || k == 1;
}

// ── Structural equality ──────────────────────────────────────────────────

// Same-SHAPE equality (kind + literal/var_id + recursively-equal
// children), NOT semantic/commutative equality -- 1+2 and 2+1 are NOT
// equal here. Commutative canonicalization is a v0.2 simplification-tier
// concern. Assumes both indices live in the SAME arena; comparing across
// two different arenas isn't supported in v0.1.0.
// NO #[wcet]: recursion depth is the tree depth, a runtime value.
// WCET formula: ~15 * (number of nodes in the smaller of the two
// subtrees being compared, since a kind mismatch short-circuits).
fn sym_eq_structural(arena: ref Vec<ExprNode>, a: i64, b: i64) -> bool {
    let na: ExprNode = arena[a];
    let nb: ExprNode = arena[b];
    if na.kind != nb.kind {
        return false;
    }
    if na.kind == 0 || na.kind == 1 {
        return na.value == nb.value;
    }
    if na.kind == 7 {
        return sym_eq_structural(arena, na.left, nb.left);
    }
    if sym_eq_structural(arena, na.left, nb.left) == false {
        return false;
    }
    return sym_eq_structural(arena, na.right, nb.right);
}

// ── Evaluation ───────────────────────────────────────────────────────────

// `var_values` is indexed directly by var_id (see the header comment) --
// no symbol table needed here, no string comparison anywhere in this
// function or anything it calls.
// NO #[wcet]: recursion depth is the tree depth, a runtime value.
// WCET formula: ~20 * (number of nodes in the subtree rooted at `root`),
// plus _sym_ipow's own formula for any Pow node encountered.
fn sym_eval(arena: ref Vec<ExprNode>, root: i64, var_values: ref Vec<i64>) -> i64 {
    let node: ExprNode = arena[root];
    if node.kind == 0 {
        return node.value;
    }
    if node.kind == 1 {
        assert node.value >= 0;
        assert node.value < (len(var_values) as i64);
        return var_values[node.value];
    }
    if node.kind == 7 {
        return 0 - sym_eval(arena, node.left, var_values);
    }
    let lv: i64 = sym_eval(arena, node.left, var_values);
    let rv: i64 = sym_eval(arena, node.right, var_values);
    if node.kind == 2 {
        return lv + rv;
    }
    if node.kind == 3 {
        return lv - rv;
    }
    if node.kind == 4 {
        return lv * rv;
    }
    if node.kind == 5 {
        return lv / rv;
    }
    // kind == 6: Pow. v0.1.0 supports nonnegative integer exponents only
    // -- no rationals/floats in this tier yet -- traps otherwise,
    // matching this ecosystem's "assert on out-of-scope input"
    // convention (e.g. vani-bignum's bn_div_mod asserting a nonzero
    // divisor rather than silently misbehaving).
    assert rv >= 0;
    return _sym_ipow(lv, rv);
}

// Exponentiation by squaring, O(log exp) -- the same technique
// vani-bignum's TODO.md names for its own future bn_pow_i64.
// NO #[wcet]: loop bound is log2(exp), a runtime value.
// WCET formula: ~10 * log2(exponent + 1).
#[bounded_stack(bytes = 104)]
fn _sym_ipow(base: i64, exponent: i64) -> i64 {
    let result: i64 = 1;
    let b: i64 = base;
    let e: i64 = exponent;
    while e > 0 {
        if e - (e / 2) * 2 == 1 {
            result = result * b;
        }
        b = b * b;
        e = e / 2;
    }
    return result;
}

// ── Pretty-printing ──────────────────────────────────────────────────────

// A genuinely new pattern in this ecosystem -- no prior precedence-driven
// printer exists in any sibling package, so there's no external "correct
// answer" to check against beyond the precedence table itself (modeled
// on Python's real operator precedence, not invented): Add/Sub=1,
// Mul/Div=2, Neg=3, Pow=4, atoms (Num/Var)=5 (never parenthesized).
// Add/Mul are fully associative for printing (an equal-precedence child
// never needs parens on either side); Sub/Div are left-associative
// (their RIGHT child needs parens at equal precedence); Pow is
// right-associative (its LEFT child needs parens at equal precedence).
// A Neg whose immediate child is itself Neg is always parenthesized,
// purely to avoid printing the visually-confusing `--x`. Spacing:
// spaces around `+`/`-`, none around `*`/`/`/`^`, matching SymPy's
// str() convention -- this file is the single source of truth for
// tests/test_print.vani's expected strings, since no external spec
// exists for this new pattern.
fn sym_to_str(arena: ref Vec<ExprNode>, table: ref SymbolTable, root: i64) -> OwnedStr {
    return _sym_to_str_prec(arena, table, root, 0);
}

// `min_required`: the minimum precedence this subtree must have to print
// unparenthesized in its caller's position. 0 at the top level (nothing
// is ever wrapped there).
// NO #[wcet]: recursion depth is the tree depth, a runtime value.
// WCET formula: ~30 * (number of nodes in the subtree rooted at `idx`).
fn _sym_to_str_prec(arena: ref Vec<ExprNode>, table: ref SymbolTable, idx: i64, min_required: i64) -> OwnedStr {
    let node: ExprNode = arena[idx];
    if node.kind == 0 {
        return i64_to_str(node.value);
    }
    if node.kind == 1 {
        return symtab_name_at(table, node.value);
    }
    if node.kind == 7 {
        let child_min: i64 = 3;
        if arena[node.left].kind == 7 {
            child_min = 4; // force parens around a nested Neg, avoids "--x"
        }
        let inner: OwnedStr = _sym_to_str_prec(arena, table, node.left, child_min);
        let s: OwnedStr = "-" + inner;
        return _sym_wrap_if_needed(s, 3, min_required);
    }
    let my_prec: i64 = _sym_prec(node.kind);
    let left_min: i64 = my_prec;
    let right_min: i64 = my_prec;
    if node.kind == 3 || node.kind == 5 {
        right_min = my_prec + 1; // Sub, Div: left-associative
    }
    if node.kind == 6 {
        left_min = my_prec + 1; // Pow: right-associative
    }
    let ls: OwnedStr = _sym_to_str_prec(arena, table, node.left, left_min);
    let rs: OwnedStr = _sym_to_str_prec(arena, table, node.right, right_min);
    let combined: OwnedStr = ls + _sym_op_str(node.kind) + rs;
    return _sym_wrap_if_needed(combined, my_prec, min_required);
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 42)]
fn _sym_prec(kind: i64) -> i64 {
    if kind == 2 || kind == 3 {
        return 1; // Add, Sub
    }
    if kind == 4 || kind == 5 {
        return 2; // Mul, Div
    }
    return 4; // Pow (kind == 6)
}

#[bounded_stack(bytes = 80)]
#[wcet(cycles = 69)]
fn _sym_op_str(kind: i64) -> OwnedStr {
    if kind == 2 {
        return " + " + "";
    }
    if kind == 3 {
        return " - " + "";
    }
    if kind == 4 {
        return "*" + "";
    }
    if kind == 5 {
        return "/" + "";
    }
    return "^" + ""; // Pow
}

#[bounded_stack(bytes = 72)]
#[wcet(cycles = 24)]
fn _sym_wrap_if_needed(s: OwnedStr, my_prec: i64, min_required: i64) -> OwnedStr {
    if my_prec < min_required {
        return "(" + s + ")";
    }
    return s;
}

// ── Simplification (v0.2.0) ─────────────────────────────────────────────

// Builds a simplified copy of the subtree rooted at `root` (an index
// into `src`) into `dst` -- a SEPARATE arena the caller owns, appended
// to via the same builder functions construction uses (sym_num,
// sym_add, ...). `dst` is typically empty at the top-level call; it is
// never mutated in place, matching the "arena only ever grows, a
// simplifier builds a fresh output arena rather than rewriting nodes"
// note from v0.1.0. Returns the index of the simplified result in
// `dst`. No SymbolTable needed -- everything here operates on var_ids
// numerically, names are never compared or read.
//
// Two layers, in order of implementation (see kosh-index/ROADMAP.md's
// vani-symbolic scoping breakdown for the full phased plan this splits
// across versions):
//  - Layer 1 (this version): bottom-up constant folding + identities
//    for Num/Var/Neg/Mul/Div/Pow. Add/Sub currently only recurse into
//    their children and rebuild plainly (no folding/identities/like-
//    term collection yet) -- always correct, just not yet as simplified
//    as it will be once Layer 2 lands in the same version.
//  - Layer 2 (next in this same version, not yet built): replaces the
//    plain Add/Sub handling below with flatten-and-collect (see the
//    scoping breakdown's Layer 2 description).
//
// NO #[wcet]: recursion depth is the tree depth, a runtime value.
// WCET formula: ~40 * (number of nodes in the subtree rooted at `root`).
fn sym_simplify(src: ref Vec<ExprNode>, root: i64, dst: mut ref Vec<ExprNode>) -> i64 {
    let node: ExprNode = src[root];

    if node.kind == 0 {
        return sym_num(dst, node.value);
    }
    if node.kind == 1 {
        push(dst, ExprNode { kind: 1, value: node.value, left: 0 - 1, right: 0 - 1 });
        return (len(dst) as i64) - 1;
    }
    if node.kind == 7 {
        let inner: i64 = sym_simplify(src, node.left, dst);
        // Neg(Neg(x)) -> x. Correct even for deeper chains: each pair
        // of adjacent Negs cancels one level at a time as the
        // recursion unwinds (see src/lib.vani design notes / plan for
        // the traced-through 4-deep example).
        if dst[inner].kind == 7 {
            return dst[inner].left;
        }
        // Neg(Num) -> Num.
        if dst[inner].kind == 0 {
            return sym_num(dst, 0 - dst[inner].value);
        }
        return sym_neg(dst, inner);
    }
    if node.kind == 2 || node.kind == 3 {
        return _sym_simplify_sum(src, root, dst);
    }

    // Mul, Div, Pow: simplify children, then constant-fold or apply
    // identities on the (already-simplified) results.
    let l: i64 = sym_simplify(src, node.left, dst);
    let r: i64 = sym_simplify(src, node.right, dst);
    let lk: i64 = dst[l].kind;
    let rk: i64 = dst[r].kind;

    if lk == 0 && rk == 0 {
        return sym_num(dst, _sym_fold_binary(node.kind, dst[l].value, dst[r].value));
    }
    if node.kind == 4 {
        if rk == 0 && dst[r].value == 1 {
            return l; // x*1 -> x
        }
        if lk == 0 && dst[l].value == 1 {
            return r; // 1*x -> x
        }
        if rk == 0 && dst[r].value == 0 {
            return sym_num(dst, 0); // x*0 -> 0
        }
        if lk == 0 && dst[l].value == 0 {
            return sym_num(dst, 0); // 0*x -> 0
        }
        return sym_mul(dst, l, r);
    }
    if node.kind == 5 {
        if rk == 0 && dst[r].value == 1 {
            return l; // x/1 -> x
        }
        return sym_div(dst, l, r);
    }
    // Pow.
    if rk == 0 && dst[r].value == 1 {
        return l; // x^1 -> x
    }
    if rk == 0 && dst[r].value == 0 {
        // x^0 -> 1, safe unconditionally (even x=0): _sym_ipow already
        // returns 1 for exponent 0 regardless of base, matching
        // sym_eval's existing behavior exactly -- not a new special
        // case introduced by simplification.
        return sym_num(dst, 1);
    }
    return sym_pow(dst, l, r);
}

// Mirrors sym_eval's binary-op dispatch (kinds 2-6) exactly, including
// trap semantics -- folding a literal Num/0 still traps, correctly:
// the original would trap there too, unconditionally, since it doesn't
// depend on any variable.
// NO #[wcet]: calls _sym_ipow, whose own cost is a runtime-log(exponent)
// loop.
#[bounded_stack(bytes = 200)]
fn _sym_fold_binary(kind: i64, lv: i64, rv: i64) -> i64 {
    if kind == 2 {
        return lv + rv;
    }
    if kind == 3 {
        return lv - rv;
    }
    if kind == 4 {
        return lv * rv;
    }
    if kind == 5 {
        return lv / rv;
    }
    assert rv >= 0;
    return _sym_ipow(lv, rv);
}

// Layer 2: flatten a chain of nested Add/Sub nodes (stopping at any
// other kind) into parallel (sign, src_term_idx) accumulators. Descending
// into an Add's children keeps the incoming sign for both; descending
// into a Sub's children keeps it for the left child and flips it for
// the right. Terms themselves are left unsimplified here -- the caller
// (_sym_simplify_sum) simplifies each one individually so folding and
// identities apply within a term before classification.
// NO #[wcet]: recursion depth is the tree depth, a runtime value.
fn _sym_flatten_sum(src: ref Vec<ExprNode>, root: i64, signs: mut ref Vec<i64>, terms: mut ref Vec<i64>, sign: i64) {
    let node: ExprNode = src[root];
    if node.kind == 2 {
        _sym_flatten_sum(src, node.left, signs, terms, sign);
        _sym_flatten_sum(src, node.right, signs, terms, sign);
    } else {
        if node.kind == 3 {
            _sym_flatten_sum(src, node.left, signs, terms, sign);
            _sym_flatten_sum(src, node.right, signs, terms, 0 - sign);
        } else {
            push(signs, sign);
            push(terms, root);
        }
    }
}

// Layer 2 entry point for any Add/Sub node reached by sym_simplify's
// top-level dispatch. Scope (see the v0.2.0 plan for the full
// rationale): only collects terms that are a Num, a bare Var, or a
// Mul(Num,Var)/Mul(Var,Num) single-variable monomial -- anything else
// (a product of two variables, a Pow, a nested non-monomial Mul, ...)
// is kept as an opaque, unmerged term in its original relative
// position. This is NOT general polynomial normal form.
// NO #[wcet]: loop bounds are the number of flattened terms, a runtime
// value.
// WCET formula: ~60 * (number of flattened terms)^2 (the var-lookup and
// sort steps are both O(terms) per term in the worst case).
fn _sym_simplify_sum(src: ref Vec<ExprNode>, root: i64, dst: mut ref Vec<ExprNode>) -> i64 {
    let signs: Vec<i64> = vec();
    let terms: Vec<i64> = vec();
    _sym_flatten_sum(src, root, mut ref signs, mut ref terms, 1);

    let const_acc: i64 = 0;
    let found_ids: Vec<i64> = vec();
    let found_coeffs: Vec<i64> = vec();
    let found_nodes: Vec<i64> = vec();
    let opaque_signs: Vec<i64> = vec();
    let opaque_idxs: Vec<i64> = vec();

    let i: i64 = 0;
    let n: i64 = len(ref terms) as i64;
    while i < n {
        let s: i64 = signs[i];
        let t: i64 = terms[i];
        let simplified: i64 = sym_simplify(src, t, dst);
        let sk: i64 = dst[simplified].kind;

        if sk == 0 {
            const_acc = const_acc + s * dst[simplified].value;
        } else {
            let var_id: i64 = 0 - 1;
            let coeff: i64 = 0;
            let is_monomial: bool = false;
            let var_node_idx: i64 = simplified;

            if sk == 1 {
                var_id = dst[simplified].value;
                coeff = s;
                is_monomial = true;
            } else {
                if sk == 4 {
                    let lch: ExprNode = dst[dst[simplified].left];
                    let rch: ExprNode = dst[dst[simplified].right];
                    if lch.kind == 0 && rch.kind == 1 {
                        var_id = rch.value;
                        coeff = s * lch.value;
                        is_monomial = true;
                        var_node_idx = dst[simplified].right;
                    } else {
                        if lch.kind == 1 && rch.kind == 0 {
                            var_id = lch.value;
                            coeff = s * rch.value;
                            is_monomial = true;
                            var_node_idx = dst[simplified].left;
                        }
                    }
                }
            }

            if is_monomial {
                let j: i64 = 0;
                let found_n: i64 = len(ref found_ids) as i64;
                let found: bool = false;
                while j < found_n {
                    if found_ids[j] == var_id {
                        set(mut ref found_coeffs, j, found_coeffs[j] + coeff);
                        found = true;
                    }
                    j = j + 1;
                }
                if found == false {
                    push(mut ref found_ids, var_id);
                    push(mut ref found_coeffs, coeff);
                    push(mut ref found_nodes, var_node_idx);
                }
            } else {
                push(mut ref opaque_signs, s);
                push(mut ref opaque_idxs, simplified);
            }
        }
        i = i + 1;
    }

    // Rebuild: opaque terms (original order) first, then variable terms
    // sorted by ascending var_id (small insertion sort -- the number of
    // distinct variables in one flattened sum is small), then the
    // constant last.
    let result: i64 = 0 - 1;
    let has_result: bool = false;

    let oi: i64 = 0;
    let on: i64 = len(ref opaque_idxs) as i64;
    while oi < on {
        let piece: i64 = opaque_idxs[oi];
        if opaque_signs[oi] < 0 {
            piece = sym_neg(dst, piece);
        }
        if has_result {
            result = sym_add(dst, result, piece);
        } else {
            result = piece;
            has_result = true;
        }
        oi = oi + 1;
    }

    let vn: i64 = len(ref found_ids) as i64;
    let vi: i64 = 1;
    while vi < vn {
        let vj: i64 = vi;
        while vj > 0 && found_ids[vj - 1] > found_ids[vj] {
            vec_swap(mut ref found_ids, vj - 1, vj);
            vec_swap(mut ref found_coeffs, vj - 1, vj);
            vec_swap(mut ref found_nodes, vj - 1, vj);
            vj = vj - 1;
        }
        vi = vi + 1;
    }

    let vk: i64 = 0;
    while vk < vn {
        let coeff: i64 = found_coeffs[vk];
        if coeff != 0 {
            let piece: i64 = found_nodes[vk];
            if coeff != 1 {
                piece = sym_mul(dst, sym_num(dst, coeff), piece);
            }
            if has_result {
                result = sym_add(dst, result, piece);
            } else {
                result = piece;
                has_result = true;
            }
        }
        vk = vk + 1;
    }

    if const_acc != 0 || has_result == false {
        if has_result {
            result = sym_add(dst, result, sym_num(dst, const_acc));
        } else {
            result = sym_num(dst, const_acc);
            has_result = true;
        }
    }

    return result;
}

// ── Differentiation (v0.3.0) ─────────────────────────────────────────────

// Differentiates the subtree rooted at `root` with respect to `var_id`,
// appending new derivative-combinator nodes to the SAME arena `root`
// already lives in. Unlike sym_simplify's separate-dst design,
// differentiation reuses existing node indices directly for any
// subexpression that appears unchanged in the derivative (e.g. `v` in the
// product rule's `u'*v + u*v'`) -- safe because the arena only ever grows
// and a node index stays valid forever once returned. Raw output is
// deliberately NOT simplified here: the v0.3.0 plan calls sym_simplify a
// separate, composable pass (run it on the result to fold `1*x`, `x+0`,
// `x^1`, etc. into something readable) rather than folding here too.
//
// One rule per node kind -- covers the full kind set (0-7), no kind is
// left unhandled:
//   Num          -> 0
//   Var          -> 1 if this is var_id, else 0
//   Add(u,v)     -> u' + v'
//   Sub(u,v)     -> u' - v'
//   Neg(u)       -> -u'
//   Mul(u,v)     -> u'*v + u*v'                    (product rule)
//   Div(u,v)     -> (u'*v - u*v') / (v*v)           (quotient rule)
//   Pow(u,n)     -> n * u^(n-1) * u'                (power rule + chain rule)
//     `n` (the exponent node) must be a literal Num -- a variable/
//     expression exponent needs log-differentiation, out of scope (an
//     extension of v0.1.0's existing "Pow: nonnegative integer exponent
//     only" restriction). `n == 0` is a special case (u^(n-1) would need
//     exponent -1, which sym_pow's own bounds don't support) -- handled
//     directly since d(u^0)/dx = d(1)/dx = 0.
//
// Every local below has a rule-specific name suffix (_add/_sub/_neg/
// _mul/_div/_pow), even across non-overlapping if-branches -- vāṇī's LLVM
// backend has a known codegen bug where reusing one local name across
// sibling branches of the same function can crash with "multiple
// definition of local value" even though the branches never execute
// together (see kosh-index ecosystem notes); giving every branch fully
// distinct names sidesteps it entirely.
//
// NO #[wcet]: recursion depth is the tree depth, a runtime value.
// WCET formula: ~50 * (number of nodes in the subtree rooted at `root`)
// -- product/quotient rules each differentiate both children once, same
// asymptotic shape as sym_eval/sym_simplify.
fn sym_diff(arena: mut ref Vec<ExprNode>, root: i64, var_id: i64) -> i64 {
    let node: ExprNode = arena[root];

    if node.kind == 0 {
        return sym_num(arena, 0);
    }
    if node.kind == 1 {
        if node.value == var_id {
            return sym_num(arena, 1);
        }
        return sym_num(arena, 0);
    }
    if node.kind == 2 {
        let du_add: i64 = sym_diff(arena, node.left, var_id);
        let dv_add: i64 = sym_diff(arena, node.right, var_id);
        return sym_add(arena, du_add, dv_add);
    }
    if node.kind == 3 {
        let du_sub: i64 = sym_diff(arena, node.left, var_id);
        let dv_sub: i64 = sym_diff(arena, node.right, var_id);
        return sym_sub(arena, du_sub, dv_sub);
    }
    if node.kind == 7 {
        let du_neg: i64 = sym_diff(arena, node.left, var_id);
        return sym_neg(arena, du_neg);
    }
    if node.kind == 4 {
        let u_mul: i64 = node.left;
        let v_mul: i64 = node.right;
        let du_mul: i64 = sym_diff(arena, u_mul, var_id);
        let dv_mul: i64 = sym_diff(arena, v_mul, var_id);
        let term1_mul: i64 = sym_mul(arena, du_mul, v_mul);
        let term2_mul: i64 = sym_mul(arena, u_mul, dv_mul);
        return sym_add(arena, term1_mul, term2_mul);
    }
    if node.kind == 5 {
        let u_div: i64 = node.left;
        let v_div: i64 = node.right;
        let du_div: i64 = sym_diff(arena, u_div, var_id);
        let dv_div: i64 = sym_diff(arena, v_div, var_id);
        let term1_div: i64 = sym_mul(arena, du_div, v_div);
        let term2_div: i64 = sym_mul(arena, u_div, dv_div);
        let numerator_div: i64 = sym_sub(arena, term1_div, term2_div);
        let denominator_div: i64 = sym_mul(arena, v_div, v_div);
        return sym_div(arena, numerator_div, denominator_div);
    }
    // kind == 6: Pow.
    let u_pow: i64 = node.left;
    let exp_node_pow: ExprNode = arena[node.right];
    assert exp_node_pow.kind == 0;
    let n_pow: i64 = exp_node_pow.value;
    assert n_pow >= 0;
    if n_pow == 0 {
        return sym_num(arena, 0);
    }
    let du_pow: i64 = sym_diff(arena, u_pow, var_id);
    let n_minus_1_pow: i64 = sym_num(arena, n_pow - 1);
    let powed_pow: i64 = sym_pow(arena, u_pow, n_minus_1_pow);
    let coeff_pow: i64 = sym_mul(arena, sym_num(arena, n_pow), powed_pow);
    return sym_mul(arena, coeff_pow, du_pow);
}

// ── v0.5.0: Equation solving (degree <= 2) ───────────────────────────────
//
// "Thin layer" per the roadmap's own risk rating -- most of the actual
// root-finding work is already done in vani-algebra's
// `algebra_poly_roots_real` (linear/quadratic/cubic/quartic+ real-root
// solver), reused here rather than reimplemented. The genuinely new work
// is extracting [c0, c1, c2] polynomial coefficients out of a symbolic
// expression tree.
//
// COEFFICIENT EXTRACTION SCOPE: deliberately narrow, NOT a general
// polynomial normalizer (that would need full expansion/collection --
// sym_simplify's own v0.2.0 header already documents why that's out of
// scope: "NOT general polynomial normal form"). Reuses
// `_sym_flatten_sum` (the exact same proven Add/Sub walker
// `sym_simplify`'s own Layer 2 uses) to un-nest the top-level sum into
// signed terms, sym_simplify's each term individually (so e.g.
// `(x+0)^2` reduces to `x^2` before classification, same as
// `_sym_simplify_sum` does), then classifies each simplified term into
// one of five recognized shapes:
//   Num                          -> contributes to c0
//   Var(var_id)                  -> contributes 1 to c1
//   Mul(Num,Var)/Mul(Var,Num)    -> contributes Num to c1
//   Pow(Var(var_id), Num=2)      -> contributes 1 to c2
//   Mul(Num,Pow)/Mul(Pow,Num)    -> contributes Num to c2 (Pow as above)
// Any other shape (x^3, x*y, sin(x), an unrelated variable, ...) makes
// extraction return ok=false -- an explicit "no rule matched" signal,
// not a guess or a silent wrong answer (same discipline v0.4.0's
// integration pattern table already documents needing).

struct SymPolyCoeffs {
    ok: bool,
    c0: f64,
    c1: f64,
    c2: f64,
}

// True if `dst[idx]` is exactly `Pow(Var(var_id), Num(2))` -- the one
// degree-2 shape this phase recognizes (no `x^2.0`-as-float case: `Pow`'s
// own exponent field is the same `i64` literal `_sym_ipow` already
// requires for evaluation).
#[bounded_stack(bytes = 154)]
#[wcet(cycles = 85)]
fn _sym_is_var_squared(dst: ref Vec<ExprNode>, idx: i64, var_id: i64) -> bool {
    let node: ExprNode = dst[idx];
    if node.kind != 6 {
        return false;
    }
    let base: ExprNode = dst[node.left];
    let exp: ExprNode = dst[node.right];
    return base.kind == 1 && base.value == var_id && exp.kind == 0 && exp.value == 2;
}

// NO #[wcet]: recursion depth (via _sym_flatten_sum) and the number of
// flattened terms are both runtime values.
// WCET formula: ~30 * (number of flattened terms), plus sym_simplify's
// own per-term cost.
fn sym_poly_coeffs_le2(src: ref Vec<ExprNode>, root: i64, var_id: i64) -> SymPolyCoeffs {
    let signs: Vec<i64> = vec();
    let terms: Vec<i64> = vec();
    _sym_flatten_sum(src, root, mut ref signs, mut ref terms, 1);

    let dst: Vec<ExprNode> = sym_arena_new();
    let c0: f64 = 0.0;
    let c1: f64 = 0.0;
    let c2: f64 = 0.0;
    let n: i64 = len(ref terms) as i64;
    let i: i64 = 0;
    while i < n {
        let s: f64 = signs[i] as f64;
        let t: i64 = terms[i];
        let simplified: i64 = sym_simplify(src, t, mut ref dst);
        let node: ExprNode = dst[simplified];

        if node.kind == 0 {
            c0 = c0 + s * (node.value as f64);
        } else if node.kind == 1 && node.value == var_id {
            c1 = c1 + s;
        } else if node.kind == 4 {
            let lch: ExprNode = dst[node.left];
            let rch: ExprNode = dst[node.right];
            if lch.kind == 0 && rch.kind == 1 && rch.value == var_id {
                c1 = c1 + s * (lch.value as f64);
            } else if lch.kind == 1 && lch.value == var_id && rch.kind == 0 {
                c1 = c1 + s * (rch.value as f64);
            } else if lch.kind == 0 && _sym_is_var_squared(ref dst, node.right, var_id) {
                c2 = c2 + s * (lch.value as f64);
            } else if _sym_is_var_squared(ref dst, node.left, var_id) && rch.kind == 0 {
                c2 = c2 + s * (rch.value as f64);
            } else {
                return SymPolyCoeffs { ok: false, c0: 0.0, c1: 0.0, c2: 0.0 };
            }
        } else if _sym_is_var_squared(ref dst, simplified, var_id) {
            c2 = c2 + s;
        } else {
            return SymPolyCoeffs { ok: false, c0: 0.0, c1: 0.0, c2: 0.0 };
        }
        i = i + 1;
    }
    return SymPolyCoeffs { ok: true, c0: c0, c1: c1, c2: c2 };
}

// Solves p(x) = 0 for real x, where `root` is a symbolic expression of
// degree <= 2 in `var_id` (recognized shapes per sym_poly_coeffs_le2
// above). Returns an empty Vec if the shape isn't recognized, or if the
// expression degenerates to a non-equation (c1 and c2 both ~0 -- either
// no solution, if c0 != 0, or every x, if c0 == 0; neither is a finite
// root list, so this phase reports "no roots" rather than guessing which
// case applies). Otherwise builds the ascending-degree coefficient Vec
// `algebra::algebra_poly_roots_real` expects and hands off to it.
// NO #[wcet]: dominated by sym_poly_coeffs_le2's own runtime-bounded cost.
fn sym_solve_poly_le2(src: ref Vec<ExprNode>, root: i64, var_id: i64) -> Vec<f64> {
    let extracted: SymPolyCoeffs = sym_poly_coeffs_le2(src, root, var_id);
    let out: Vec<f64> = vec();
    if extracted.ok == false {
        return out;
    }
    let coeffs: Vec<f64> = vec();
    if abs(extracted.c2) > 1.0e-12 {
        push(mut ref coeffs, extracted.c0);
        push(mut ref coeffs, extracted.c1);
        push(mut ref coeffs, extracted.c2);
    } else if abs(extracted.c1) > 1.0e-12 {
        push(mut ref coeffs, extracted.c0);
        push(mut ref coeffs, extracted.c1);
    } else {
        return out;
    }
    return algebra::algebra_poly_roots_real(ref coeffs);
}

// Solves lhs = rhs for real x (both sides degree <= 2 in `var_id`,
// possibly in DIFFERENT arenas -- lhs and rhs are extracted
// independently via sym_poly_coeffs_le2, then their coefficients are
// subtracted directly, rather than building a new Sub node in either
// caller's arena (which would need a `mut ref` on an arena this
// function otherwise only reads). The common real-world "equation" form
// (something = something, not pre-arranged to "= 0") this phase's
// roadmap entry calls for, built on top of sym_solve_poly_le2's
// simpler single-expression core.
fn sym_solve_equation_le2(lsrc: ref Vec<ExprNode>, lhs: i64, rsrc: ref Vec<ExprNode>, rhs: i64, var_id: i64) -> Vec<f64> {
    let l: SymPolyCoeffs = sym_poly_coeffs_le2(lsrc, lhs, var_id);
    let r: SymPolyCoeffs = sym_poly_coeffs_le2(rsrc, rhs, var_id);
    let out: Vec<f64> = vec();
    if l.ok == false || r.ok == false {
        return out;
    }
    let c0: f64 = l.c0 - r.c0;
    let c1: f64 = l.c1 - r.c1;
    let c2: f64 = l.c2 - r.c2;
    let coeffs: Vec<f64> = vec();
    if abs(c2) > 1.0e-12 {
        push(mut ref coeffs, c0);
        push(mut ref coeffs, c1);
        push(mut ref coeffs, c2);
    } else if abs(c1) > 1.0e-12 {
        push(mut ref coeffs, c0);
        push(mut ref coeffs, c1);
    } else {
        return out;
    }
    return algebra::algebra_poly_roots_real(ref coeffs);
}

// ── v0.4.0: Symbolic integration (polynomial, fixed pattern table) ──────
//
// SCOPE CORRECTION found during implementation, not before: the
// roadmap's original v0.4.0 scope text mentions "elementary
// exp/ln/sin/cos antiderivatives", but `ExprNode`'s kind set has never
// grown past the 8 kinds v0.1.0 shipped with (0=Num 1=Var 2=Add 3=Sub
// 4=Mul 5=Div 6=Pow 7=Neg) -- adding transcendental-function kinds would
// mean extending EVERY existing walker (`sym_eval`, `sym_diff`,
// `sym_simplify`, `sym_to_str`, `sym_eq_structural`), a much larger
// undertaking than "add integration" alone. Same kind of correction
// v0.3.0 (`vani-tensor` never actually needed) and v0.5.0 (`vani-algebra`
// itself needed a dependency-version bump) already made explicit here.
// This phase covers POLYNOMIAL integration only, over the existing kind
// set: power rule, sum/difference/constant-multiple rules, and a small
// set of recognized linear-u-substitution shapes (`(a*x+b)^n`) -- the
// realistic "small set of recognized shapes" the roadmap's own wording
// already anticipated, just without the transcendental cases.
//
// Fixed pattern table, explicit no-match (same discipline
// `sym_poly_coeffs_le2` already established for v0.5.0): every rule
// either fires and returns `ok=true`, or the whole call returns
// `ok=false` -- never a guess. Rules recognized:
//   Num c                    -> c*x                (constant rule)
//   Var(var_id)               -> x^2/2               (bare integration var)
//   Var(other)                -> other*x             (treated as constant)
//   Add(f,g) / Sub(f,g)       -> ∫f ± ∫g              (linearity)
//   Neg(f)                    -> -∫f
//   Mul(const,f) / Mul(f,const) where exactly one side doesn't contain
//                                var_id              -> const * ∫f
//   f/const (const doesn't contain var_id)           -> (∫f) / const
//   Pow(Var(var_id), Num=n), n != -1                 -> x^(n+1)/(n+1)
//   Pow(base, Num=n), n != -1, base doesn't contain
//     var_id at all                                  -> base^n * x (constant)
//   Pow(a*x+b, Num=n), n != -1, recognized linear
//     base shape (`_sym_linear_shape` below)          -> (ax+b)^(n+1) / (a*(n+1))
// Everything else (Pow with a variable/non-literal exponent, Pow with
// n=-1, a product/quotient of two var_id-dependent factors, a
// non-linear Pow base, ...) returns ok=false -- integration by parts,
// partial fractions, and 1/x -> ln|x| are all out of scope, same
// "not a general algorithm (no Risch)" boundary the roadmap already
// drew.
//
// VALIDATION: every rule that fires is checked against the fundamental
// theorem of calculus (sym_diff(result) evaluated at several sample
// points ≈ the ORIGINAL expression evaluated at the same points) --
// evaluation-based, not structural equality, matching the roadmap's own
// explicit "post-simplification structural OR evaluated-at-sample-points
// equality" allowance (sym_diff's raw output isn't simplified, so exact
// structural equality to the original would be too strict a bar here).

struct SymIntegrateResult {
    ok: bool,
    idx: i64,
}

// True if `idx` (or any descendant) is a Var node matching var_id --
// the "does this subexpression depend on the integration variable"
// check the constant-multiple and constant-Pow-base rules both need.
// NO #[wcet]: recursion depth is the tree depth, a runtime value.
fn _sym_contains_var(arena: mut ref Vec<ExprNode>, idx: i64, var_id: i64) -> bool {
    let node: ExprNode = arena[idx];
    if node.kind == 1 {
        return node.value == var_id;
    }
    if node.kind == 0 {
        return false;
    }
    if node.kind == 7 {
        return _sym_contains_var(arena, node.left, var_id);
    }
    if _sym_contains_var(arena, node.left, var_id) {
        return true;
    }
    return _sym_contains_var(arena, node.right, var_id);
}

struct SymLinearShape {
    ok: bool,
    a: i64,
    b: i64,
}

// Recognizes a SMALL set of `a*x + b` shapes as actually built by this
// file's own constructors (`Var`, `Mul(Num,Var)`/`Mul(Var,Num)`,
// `Add`/`Sub` of one of those with a `Num`, and the commuted
// `Add(Num, linear)` form) -- NOT the general degree<=2 extraction
// `sym_poly_coeffs_le2` does for v0.5.0 (that function takes `ref`,
// which can't be called from here: `arena` is already `mut ref` in
// `sym_integrate`, and the checker doesn't reborrow a `mut ref` binding
// as `ref` at a call site -- same limitation this file's own `sym_add`
// comment already documents; a dedicated `mut ref`-native, purely
// recursive helper sidesteps it instead of re-hitting it). `a == 0`
// means "not recognized as linear", same as `ok == false`.
// NO #[wcet]: recursion depth is the tree depth, a runtime value.
fn _sym_linear_shape(arena: mut ref Vec<ExprNode>, idx: i64, var_id: i64) -> SymLinearShape {
    let node: ExprNode = arena[idx];
    if node.kind == 1 && node.value == var_id {
        return SymLinearShape { ok: true, a: 1, b: 0 };
    }
    if node.kind == 4 {
        let lch: ExprNode = arena[node.left];
        let rch: ExprNode = arena[node.right];
        if lch.kind == 0 && rch.kind == 1 && rch.value == var_id {
            return SymLinearShape { ok: true, a: lch.value, b: 0 };
        }
        if rch.kind == 0 && lch.kind == 1 && lch.value == var_id {
            return SymLinearShape { ok: true, a: rch.value, b: 0 };
        }
        return SymLinearShape { ok: false, a: 0, b: 0 };
    }
    if node.kind == 2 {
        let rch: ExprNode = arena[node.right];
        if rch.kind == 0 {
            let l: SymLinearShape = _sym_linear_shape(arena, node.left, var_id);
            if l.ok {
                return SymLinearShape { ok: true, a: l.a, b: l.b + rch.value };
            }
        }
        let lch: ExprNode = arena[node.left];
        if lch.kind == 0 {
            let r: SymLinearShape = _sym_linear_shape(arena, node.right, var_id);
            if r.ok {
                return SymLinearShape { ok: true, a: r.a, b: r.b + lch.value };
            }
        }
        return SymLinearShape { ok: false, a: 0, b: 0 };
    }
    if node.kind == 3 {
        let rch: ExprNode = arena[node.right];
        if rch.kind == 0 {
            let l: SymLinearShape = _sym_linear_shape(arena, node.left, var_id);
            if l.ok {
                return SymLinearShape { ok: true, a: l.a, b: l.b - rch.value };
            }
        }
        return SymLinearShape { ok: false, a: 0, b: 0 };
    }
    return SymLinearShape { ok: false, a: 0, b: 0 };
}

// Constructs a fresh Var node referencing an ALREADY-KNOWN var_id
// directly -- sym_integrate already has the var_id it's integrating
// with respect to, so the SymbolTable machinery sym_var needs (to turn
// a NAME into a var_id) doesn't apply here. Same low-level ExprNode
// push sym_var itself does internally, minus the symtab_intern step.
#[bounded_stack(bytes = 56)]
#[wcet(cycles = 36)]
fn _sym_var_ref(arena: mut ref Vec<ExprNode>, var_id: i64) -> i64 {
    push(arena, ExprNode { kind: 1, value: var_id, left: 0 - 1, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

// NO #[wcet]: recursion depth is the tree depth, a runtime value.
fn sym_integrate(arena: mut ref Vec<ExprNode>, root: i64, var_id: i64) -> SymIntegrateResult {
    let node: ExprNode = arena[root];

    if node.kind == 0 {
        let x: i64 = _sym_var_ref(arena, var_id);
        let idx: i64 = sym_mul(arena, root, x);
        return SymIntegrateResult { ok: true, idx: idx };
    }

    if node.kind == 1 {
        if node.value == var_id {
            let x_sq: i64 = sym_pow(arena, root, sym_num(arena, 2));
            let idx: i64 = sym_div(arena, x_sq, sym_num(arena, 2));
            return SymIntegrateResult { ok: true, idx: idx };
        }
        let x: i64 = _sym_var_ref(arena, var_id);
        let idx: i64 = sym_mul(arena, root, x);
        return SymIntegrateResult { ok: true, idx: idx };
    }

    if node.kind == 2 {
        let li: SymIntegrateResult = sym_integrate(arena, node.left, var_id);
        if li.ok == false {
            return SymIntegrateResult { ok: false, idx: 0 - 1 };
        }
        let ri: SymIntegrateResult = sym_integrate(arena, node.right, var_id);
        if ri.ok == false {
            return SymIntegrateResult { ok: false, idx: 0 - 1 };
        }
        let idx: i64 = sym_add(arena, li.idx, ri.idx);
        return SymIntegrateResult { ok: true, idx: idx };
    }

    if node.kind == 3 {
        let li: SymIntegrateResult = sym_integrate(arena, node.left, var_id);
        if li.ok == false {
            return SymIntegrateResult { ok: false, idx: 0 - 1 };
        }
        let ri: SymIntegrateResult = sym_integrate(arena, node.right, var_id);
        if ri.ok == false {
            return SymIntegrateResult { ok: false, idx: 0 - 1 };
        }
        let idx: i64 = sym_sub(arena, li.idx, ri.idx);
        return SymIntegrateResult { ok: true, idx: idx };
    }

    if node.kind == 7 {
        let ci: SymIntegrateResult = sym_integrate(arena, node.left, var_id);
        if ci.ok == false {
            return SymIntegrateResult { ok: false, idx: 0 - 1 };
        }
        let idx: i64 = sym_neg(arena, ci.idx);
        return SymIntegrateResult { ok: true, idx: idx };
    }

    if node.kind == 4 {
        let l_has: bool = _sym_contains_var(arena, node.left, var_id);
        let r_has: bool = _sym_contains_var(arena, node.right, var_id);
        if l_has == false && r_has == true {
            let ri: SymIntegrateResult = sym_integrate(arena, node.right, var_id);
            if ri.ok == false {
                return SymIntegrateResult { ok: false, idx: 0 - 1 };
            }
            let idx: i64 = sym_mul(arena, node.left, ri.idx);
            return SymIntegrateResult { ok: true, idx: idx };
        }
        if r_has == false && l_has == true {
            let li: SymIntegrateResult = sym_integrate(arena, node.left, var_id);
            if li.ok == false {
                return SymIntegrateResult { ok: false, idx: 0 - 1 };
            }
            let idx: i64 = sym_mul(arena, li.idx, node.right);
            return SymIntegrateResult { ok: true, idx: idx };
        }
        if l_has == false && r_has == false {
            let x: i64 = _sym_var_ref(arena, var_id);
            let idx: i64 = sym_mul(arena, root, x);
            return SymIntegrateResult { ok: true, idx: idx };
        }
        return SymIntegrateResult { ok: false, idx: 0 - 1 };
    }

    if node.kind == 5 {
        let r_has: bool = _sym_contains_var(arena, node.right, var_id);
        if r_has == false {
            let li: SymIntegrateResult = sym_integrate(arena, node.left, var_id);
            if li.ok == false {
                return SymIntegrateResult { ok: false, idx: 0 - 1 };
            }
            let idx: i64 = sym_div(arena, li.idx, node.right);
            return SymIntegrateResult { ok: true, idx: idx };
        }
        return SymIntegrateResult { ok: false, idx: 0 - 1 };
    }

    if node.kind == 6 {
        let exp_node: ExprNode = arena[node.right];
        if exp_node.kind != 0 {
            return SymIntegrateResult { ok: false, idx: 0 - 1 };
        }
        let n: i64 = exp_node.value;
        let base_has: bool = _sym_contains_var(arena, node.left, var_id);
        if base_has == false {
            let x: i64 = _sym_var_ref(arena, var_id);
            let idx: i64 = sym_mul(arena, root, x);
            return SymIntegrateResult { ok: true, idx: idx };
        }
        if n == 0 - 1 {
            return SymIntegrateResult { ok: false, idx: 0 - 1 };
        }
        let base_node: ExprNode = arena[node.left];
        if base_node.kind == 1 && base_node.value == var_id {
            let x_np1: i64 = sym_pow(arena, node.left, sym_num(arena, n + 1));
            let idx: i64 = sym_div(arena, x_np1, sym_num(arena, n + 1));
            return SymIntegrateResult { ok: true, idx: idx };
        }
        let shape: SymLinearShape = _sym_linear_shape(arena, node.left, var_id);
        if shape.ok && shape.a != 0 {
            let np1: i64 = n + 1;
            let denom: i64 = shape.a * np1;
            if denom != 0 {
                let base_np1: i64 = sym_pow(arena, node.left, sym_num(arena, np1));
                let idx: i64 = sym_div(arena, base_np1, sym_num(arena, denom));
                return SymIntegrateResult { ok: true, idx: idx };
            }
        }
        return SymIntegrateResult { ok: false, idx: 0 - 1 };
    }

    return SymIntegrateResult { ok: false, idx: 0 - 1 };
}

// ── v0.6.0+: Polynomial factorization (rational roots + synthetic division) ──
//
// Folds in what would have been a separate `vani-polyalgebra` repo, per
// the roadmap's explicit "fold into vani-symbolic" decision. Scope:
// the rational-root theorem (finds every EXACT rational root of an
// integer-coefficient polynomial, verified via exact integer
// arithmetic -- no floating-point error anywhere in detection) plus
// synthetic division to reduce degree; a numeric fallback (reusing
// vani-algebra's already-published `algebra_poly_deflate`) handles
// repeated-root multiplicity and whatever's left once every rational
// root is removed. Gröbner bases and factorization over anything but
// the rationals stay out of scope, matching the roadmap's own explicit
// framing ("mirroring vani-algebra's existing closed-form + numeric
// fallback, real roots only precedent").
//
// Two API levels, mirroring vani-algebra's own convention of working
// directly on ascending-degree coefficient vectors rather than forcing
// everything through a symbolic tree:
//   `poly_rational_roots`/`poly_factor_rational` -- take `Vec<i64>`
//     directly; the actual algorithm, no `ExprNode` involved.
//   `sym_poly_coeffs`/`sym_factor_rational` -- symbolic-tree wrappers,
//     generalizing v0.5.0's `sym_poly_coeffs_le2` from degree<=2 to
//     arbitrary degree (same recognized-shape discipline: `Num`,
//     `Var(var_id)`, `Mul(Num,Var)`, `Pow(Var,Num=k)`,
//     `Mul(Num,Pow(Var,Num=k))` -- an explicit `ok=false` for anything
//     else, never a guess).

struct PolyRationalRoot {
    num: i64,
    den: i64,
}

// q^deg * P(p/q), computed via exact integer arithmetic -- this IS the
// rational-root-theorem remainder test: p/q is an exact root of `coeffs`
// iff this returns 0. `deg` stays small for realistic symbolic-tree
// polynomials, so i64 overflow isn't a practical concern here.
// NO #[wcet]: loop bound is deg = len(coeffs)-1, a runtime value.
#[bounded_stack(bytes = 112)]
fn _poly_int_scaled_eval(coeffs: ref Vec<i64>, p: i64, q: i64) -> i64 {
    let deg: i64 = (len(coeffs) as i64) - 1;
    let sum: i64 = 0;
    let k: i64 = 0;
    while k <= deg {
        let term: i64 = coeffs[k] * i64_pow(p, k) * i64_pow(q, deg - k);
        sum = sum + term;
        k = k + 1;
    }
    return sum;
}

// Every EXACT rational root of `coeffs` (ascending degree, integer,
// `coeffs[deg] != 0`), via the rational-root theorem: any rational root
// `p/q` in lowest terms must have `p` dividing the constant term and `q`
// dividing the leading coefficient. Each candidate is verified via
// `_poly_int_scaled_eval` (exact, no floats); `p`/`q` are only ever
// accepted coprime, so no candidate is ever tested (or returned) twice
// under two different representations of the same rational value. Finds
// each DISTINCT rational root exactly once, even if it's a repeated
// root of `coeffs` -- multiplicity is `poly_factor_rational`'s job, not
// this function's (see its own comment for why).
// NO #[wcet]: loop bounds are the divisor counts of coeffs[0]/coeffs[deg],
// runtime values.
#[bounded_stack(bytes = 408)]
fn poly_rational_roots(coeffs: ref Vec<i64>) -> Vec<PolyRationalRoot> {
    let deg: i64 = (len(coeffs) as i64) - 1;
    assert deg >= 1;
    let an: i64 = coeffs[deg];
    assert an != 0;

    let out: Vec<PolyRationalRoot> = vec();

    // Rational-root-theorem divisor enumeration needs a NONZERO constant
    // term (every p "divides" 0, which isn't a useful bound). Factor out
    // `x` as many times as the constant term is exactly 0 first -- each
    // removal is itself an exact root at 0 -- leaving `reduced` with a
    // genuinely nonzero constant term (or degree 0, if `coeffs` was a
    // pure power of `x` times a constant).
    let reduced: Vec<i64> = vec();
    let n: i64 = len(coeffs) as i64;
    let i: i64 = 0;
    while i < n {
        push(mut ref reduced, coeffs[i]);
        i = i + 1;
    }
    while (len(ref reduced) as i64) > 1 && reduced[0] == 0 {
        push(mut ref out, PolyRationalRoot { num: 0, den: 1 });
        let shifted: Vec<i64> = vec();
        let rn: i64 = len(ref reduced) as i64;
        let k: i64 = 1;
        while k < rn {
            push(mut ref shifted, reduced[k]);
            k = k + 1;
        }
        reduced = shifted;
    }

    let rdeg: i64 = (len(ref reduced) as i64) - 1;
    if rdeg >= 1 {
        let a0: i64 = reduced[0];
        let ran: i64 = reduced[rdeg];
        let abs_a0: i64 = abs(a0);
        let abs_an: i64 = abs(ran);
        let p: i64 = 1;
        while p <= abs_a0 {
            if abs_a0 - (abs_a0 / p) * p == 0 {
                let q: i64 = 1;
                while q <= abs_an {
                    if abs_an - (abs_an / q) * q == 0 {
                        if i64_gcd(p, q) == 1 {
                            if _poly_int_scaled_eval(ref reduced, p, q) == 0 {
                                push(mut ref out, PolyRationalRoot { num: p, den: q });
                            }
                            if _poly_int_scaled_eval(ref reduced, 0 - p, q) == 0 {
                                push(mut ref out, PolyRationalRoot { num: 0 - p, den: q });
                            }
                        }
                    }
                    q = q + 1;
                }
            }
            p = p + 1;
        }
    }
    return out;
}

#[bounded_stack(bytes = 112)]
fn _poly_coeffs_i64_to_f64(coeffs: ref Vec<i64>) -> Vec<f64> {
    let out: Vec<f64> = vec();
    let n: i64 = len(coeffs) as i64;
    let i: i64 = 0;
    while i < n {
        push(mut ref out, coeffs[i] as f64);
        i = i + 1;
    }
    return out;
}

// Horner evaluation, ascending-degree coefficients.
// NO #[wcet]: loop bound is len(coeffs), a runtime value.
#[bounded_stack(bytes = 96)]
fn _poly_eval_f64(coeffs: ref Vec<f64>, x: f64) -> f64 {
    let n: i64 = len(coeffs) as i64;
    let result: f64 = 0.0;
    let i: i64 = n - 1;
    while i >= 0 {
        result = result * x + coeffs[i];
        i = i - 1;
    }
    return result;
}

struct PolyFactorResult {
    roots: Vec<f64>,
    remainder: Vec<f64>,
}

// Repeatedly divides every rational root found by `poly_rational_roots`
// out of `coeffs` via synthetic division (`algebra::algebra_poly_deflate`
// -- vani-algebra's own already-published, already-tested deflation
// step, reused rather than reimplemented). `roots` is returned WITH
// multiplicity, WITHOUT re-running the exact-integer rational-root
// search on each reduced polynomial: for each distinct candidate found
// on the ORIGINAL `coeffs`, this keeps deflating by that same value as
// long as the CURRENT reduced (f64) polynomial still evaluates to ~0
// there. This correctly recovers multiplicity (e.g. `(x-2)^2*(x+1)`
// -> roots `[2, 2, -1]`) via a numeric epsilon check on the reduced
// polynomial rather than a second exact-integer pass -- a deliberate,
// documented scope choice, not an oversight: repeating the exact search
// after every deflation would need re-deriving integer coefficients
// from `algebra_poly_deflate`'s f64 output, adding real complexity for
// a case (multiplicity > 1 on an already-machine-precision-exact
// synthetic division) where the numeric check is already reliable.
// `remainder` is what's left after every found rational root (with
// multiplicity) is divided out -- either a constant (fully factored
// over the rationals) or an irreducible-over-the-rationals polynomial
// with no further rational roots. Its real (possibly irrational) roots
// can still be found numerically via `algebra::algebra_poly_roots_real`,
// reused rather than reimplemented, matching the roadmap's own
// "closed-form + numeric fallback" framing for this whole phase.
// NO #[wcet]: loop bounds depend on the number of rational roots found
// and their multiplicities, runtime values.
#[bounded_stack(bytes = 656)]
fn poly_factor_rational(coeffs: ref Vec<i64>) -> PolyFactorResult {
    let candidates: Vec<PolyRationalRoot> = poly_rational_roots(coeffs);
    let cur: Vec<f64> = _poly_coeffs_i64_to_f64(coeffs);
    let roots: Vec<f64> = vec();

    let n: i64 = len(ref candidates) as i64;
    let i: i64 = 0;
    while i < n {
        let root: PolyRationalRoot = candidates[i];
        let rv: f64 = (root.num as f64) / (root.den as f64);
        let deg: i64 = (len(ref cur) as i64) - 1;
        while deg >= 1 && abs(_poly_eval_f64(ref cur, rv)) < 1.0e-7 {
            push(mut ref roots, rv);
            cur = algebra::algebra_poly_deflate(ref cur, rv);
            deg = (len(ref cur) as i64) - 1;
        }
        i = i + 1;
    }
    return PolyFactorResult { roots: roots, remainder: cur };
}

// ── Symbolic-tree wrappers ────────────────────────────────────────────

struct SymVarPowerShape {
    ok: bool,
    k: i64,
}

// Recognizes `Pow(Var(var_id), Num=k)` for any `k >= 0` -- generalizes
// v0.5.0's `_sym_is_var_squared` (hardcoded `k == 2`) to arbitrary
// degree. `k == 0` can't actually occur post-`sym_simplify` (the `x^0`
// identity already folds it to `Num(1)`), checked anyway for defense.
#[bounded_stack(bytes = 248)]
#[wcet(cycles = 104)]
fn _sym_var_power_shape(dst: ref Vec<ExprNode>, idx: i64, var_id: i64) -> SymVarPowerShape {
    let node: ExprNode = dst[idx];
    if node.kind != 6 {
        return SymVarPowerShape { ok: false, k: 0 };
    }
    let base: ExprNode = dst[node.left];
    let exp: ExprNode = dst[node.right];
    if base.kind == 1 && base.value == var_id && exp.kind == 0 && exp.value >= 0 {
        return SymVarPowerShape { ok: true, k: exp.value };
    }
    return SymVarPowerShape { ok: false, k: 0 };
}

// Grows `coeffs` with trailing zeros so index `k` is valid -- the
// dynamic-length equivalent of v0.5.0's fixed `c0`/`c1`/`c2` struct
// fields, needed here since the degree isn't known ahead of time.
// NO #[wcet]: loop bound is a runtime value (how many slots are missing).
#[bounded_stack(bytes = 56)]
fn _poly_coeffs_grow(coeffs: mut ref Vec<i64>, k: i64) -> i64 {
    while (len(coeffs) as i64) <= k {
        push(coeffs, 0);
    }
    return 0;
}

struct SymPolyCoeffsResult {
    ok: bool,
    coeffs: Vec<i64>,
}

// Extracts ascending-degree integer coefficients from a symbolic
// expression tree, generalizing v0.5.0's `sym_poly_coeffs_le2` (degree
// <=2 only, fixed `c0`/`c1`/`c2` fields) to arbitrary degree via a
// dynamically-grown `Vec<i64>`. Same extraction pipeline: reuses
// `_sym_flatten_sum` (the proven Add/Sub walker `sym_simplify`'s own
// Layer 2 already uses) to un-nest the top-level sum, `sym_simplify`s
// each term individually, then classifies each simplified term into one
// of five recognized shapes (`Num`, `Var(var_id)`,
// `Mul(Num,Var)`/`Mul(Var,Num)`, `Pow(Var,Num=k)`,
// `Mul(Num,Pow)`/`Mul(Pow,Num)`) via `_sym_var_power_shape`. Any other
// shape (`x*y`, `x^x`, `sin(x)`, an unrelated variable, ...) returns an
// explicit `ok=false` -- not a guess, same discipline every extractor in
// this file uses. Deliberately NOT a general polynomial normalizer (no
// expansion/collection across products) -- `sym_simplify`'s own v0.2.0
// header already documents that as out of scope.
// NO #[wcet]: recursion/loop bounds are the number of flattened terms
// and the tree depth, runtime values.
fn sym_poly_coeffs(src: ref Vec<ExprNode>, root: i64, var_id: i64) -> SymPolyCoeffsResult {
    let signs: Vec<i64> = vec();
    let terms: Vec<i64> = vec();
    _sym_flatten_sum(src, root, mut ref signs, mut ref terms, 1);

    let dst: Vec<ExprNode> = sym_arena_new();
    let coeffs: Vec<i64> = vec();
    let n: i64 = len(ref terms) as i64;
    let i: i64 = 0;
    while i < n {
        let s: i64 = signs[i];
        let t: i64 = terms[i];
        let simplified: i64 = sym_simplify(src, t, mut ref dst);
        let node: ExprNode = dst[simplified];

        if node.kind == 0 {
            _poly_coeffs_grow(mut ref coeffs, 0);
            set(mut ref coeffs, 0, coeffs[0] + s * node.value);
        } else if node.kind == 1 && node.value == var_id {
            _poly_coeffs_grow(mut ref coeffs, 1);
            set(mut ref coeffs, 1, coeffs[1] + s);
        } else if node.kind == 4 {
            let lch: ExprNode = dst[node.left];
            let rch: ExprNode = dst[node.right];
            if lch.kind == 0 && rch.kind == 1 && rch.value == var_id {
                _poly_coeffs_grow(mut ref coeffs, 1);
                set(mut ref coeffs, 1, coeffs[1] + s * lch.value);
            } else if rch.kind == 0 && lch.kind == 1 && lch.value == var_id {
                _poly_coeffs_grow(mut ref coeffs, 1);
                set(mut ref coeffs, 1, coeffs[1] + s * rch.value);
            } else {
                let rpow: SymVarPowerShape = _sym_var_power_shape(ref dst, node.right, var_id);
                let lpow: SymVarPowerShape = _sym_var_power_shape(ref dst, node.left, var_id);
                if lch.kind == 0 && rpow.ok {
                    _poly_coeffs_grow(mut ref coeffs, rpow.k);
                    set(mut ref coeffs, rpow.k, coeffs[rpow.k] + s * lch.value);
                } else if rch.kind == 0 && lpow.ok {
                    _poly_coeffs_grow(mut ref coeffs, lpow.k);
                    set(mut ref coeffs, lpow.k, coeffs[lpow.k] + s * rch.value);
                } else {
                    let empty_coeffs_mul: Vec<i64> = vec();
                    return SymPolyCoeffsResult { ok: false, coeffs: empty_coeffs_mul };
                }
            }
        } else {
            let pw: SymVarPowerShape = _sym_var_power_shape(ref dst, simplified, var_id);
            if pw.ok {
                _poly_coeffs_grow(mut ref coeffs, pw.k);
                set(mut ref coeffs, pw.k, coeffs[pw.k] + s);
            } else {
                let empty_coeffs_other: Vec<i64> = vec();
                return SymPolyCoeffsResult { ok: false, coeffs: empty_coeffs_other };
            }
        }
        i = i + 1;
    }

    if (len(ref coeffs) as i64) == 0 {
        push(mut ref coeffs, 0);
    }
    let top: i64 = (len(ref coeffs) as i64) - 1;
    while top > 0 && coeffs[top] == 0 {
        let _popped: i64 = pop(mut ref coeffs);
        top = top - 1;
    }
    return SymPolyCoeffsResult { ok: true, coeffs: coeffs };
}

struct SymFactorResult {
    ok: bool,
    roots: Vec<f64>,
    remainder: Vec<f64>,
}

// The symbolic-tree entry point: extracts integer coefficients via
// `sym_poly_coeffs`, then hands off to `poly_factor_rational`. `ok`
// covers BOTH failure modes -- an unrecognized expression shape, and a
// degenerate/constant expression (`deg < 1`, same "no `[c0,c1,c2]`
// fits a Vec<f64> answer" reasoning v0.5.0's own solver uses for a
// constant input).
fn sym_factor_rational(src: ref Vec<ExprNode>, root: i64, var_id: i64) -> SymFactorResult {
    let extracted: SymPolyCoeffsResult = sym_poly_coeffs(src, root, var_id);
    if extracted.ok == false {
        let no_roots_shape: Vec<f64> = vec();
        let no_remainder_shape: Vec<f64> = vec();
        return SymFactorResult { ok: false, roots: no_roots_shape, remainder: no_remainder_shape };
    }
    let deg: i64 = (len(ref extracted.coeffs) as i64) - 1;
    if deg < 1 {
        let no_roots_deg: Vec<f64> = vec();
        let no_remainder_deg: Vec<f64> = vec();
        return SymFactorResult { ok: false, roots: no_roots_deg, remainder: no_remainder_deg };
    }
    let result: PolyFactorResult = poly_factor_rational(ref extracted.coeffs);
    return SymFactorResult { ok: true, roots: result.roots, remainder: result.remainder };
}
