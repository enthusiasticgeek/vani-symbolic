use "../src/lib.vani";

// v0.5.0: equation solving (degree <= 2), reusing vani-algebra's
// algebra_poly_roots_real for the actual root-finding -- these tests
// focus on the genuinely new part, coefficient extraction from a
// symbolic expression tree, plus confirming the extracted roots satisfy
// the original expression by direct sym_eval, not just trusting the
// solver.

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-9;
}

#[test]
fn test_solve_linear_ax_plus_b() -> i64 {
    // 2x - 6 = 0  ->  x = 3
    let arena: Vec<ExprNode> = sym_arena_new();
    let table: SymbolTable = symtab_new();
    let vid: i64 = symtab_intern(mut ref table, "x");
    let x: i64 = sym_var(mut ref arena, mut ref table, "x");
    let two: i64 = sym_num(mut ref arena, 2);
    let six: i64 = sym_num(mut ref arena, 6);
    let two_x: i64 = sym_mul(mut ref arena, two, x);
    let expr: i64 = sym_sub(mut ref arena, two_x, six);

    let roots: Vec<f64> = sym_solve_poly_le2(ref arena, expr, vid);
    assert (len(ref roots) as i64) == 1;
    assert close(roots[0], 3.0);

    // Confirm the root actually satisfies the original expression.
    let var_values: Vec<i64> = vec(3);
    assert sym_eval(ref arena, expr, ref var_values) == 0;
    return 0;
}

#[test]
fn test_solve_linear_var_plus_constant() -> i64 {
    // x + 5 = 0  ->  x = -5 (bare Var term, coefficient 1)
    let arena: Vec<ExprNode> = sym_arena_new();
    let table: SymbolTable = symtab_new();
    let vid: i64 = symtab_intern(mut ref table, "x");
    let x: i64 = sym_var(mut ref arena, mut ref table, "x");
    let five: i64 = sym_num(mut ref arena, 5);
    let expr: i64 = sym_add(mut ref arena, x, five);

    let roots: Vec<f64> = sym_solve_poly_le2(ref arena, expr, vid);
    assert (len(ref roots) as i64) == 1;
    assert close(roots[0], 0.0 - 5.0);
    return 0;
}

#[test]
fn test_solve_quadratic_two_real_roots() -> i64 {
    // x^2 - 5x + 6 = 0  ->  roots {2, 3} (factors as (x-2)(x-3))
    let arena: Vec<ExprNode> = sym_arena_new();
    let table: SymbolTable = symtab_new();
    let vid: i64 = symtab_intern(mut ref table, "x");
    let x: i64 = sym_var(mut ref arena, mut ref table, "x");
    let two: i64 = sym_num(mut ref arena, 2);
    let five: i64 = sym_num(mut ref arena, 5);
    let six: i64 = sym_num(mut ref arena, 6);
    let x_sq: i64 = sym_pow(mut ref arena, x, two);
    let five_x: i64 = sym_mul(mut ref arena, five, x);
    let step1: i64 = sym_sub(mut ref arena, x_sq, five_x);
    let expr: i64 = sym_add(mut ref arena, step1, six);

    let roots: Vec<f64> = sym_solve_poly_le2(ref arena, expr, vid);
    assert (len(ref roots) as i64) == 2;
    // Order isn't guaranteed by algebra_poly_roots_real -- check the set.
    let has2: bool = close(roots[0], 2.0) || close(roots[1], 2.0);
    let has3: bool = close(roots[0], 3.0) || close(roots[1], 3.0);
    assert has2 && has3;

    let vv2: Vec<i64> = vec(2);
    let vv3: Vec<i64> = vec(3);
    assert sym_eval(ref arena, expr, ref vv2) == 0;
    assert sym_eval(ref arena, expr, ref vv3) == 0;
    return 0;
}

#[test]
fn test_solve_quadratic_coefficient_on_squared_term() -> i64 {
    // 2x^2 - 8 = 0  ->  x = +-2
    let arena: Vec<ExprNode> = sym_arena_new();
    let table: SymbolTable = symtab_new();
    let vid: i64 = symtab_intern(mut ref table, "x");
    let x: i64 = sym_var(mut ref arena, mut ref table, "x");
    let two: i64 = sym_num(mut ref arena, 2);
    let eight: i64 = sym_num(mut ref arena, 8);
    let x_sq: i64 = sym_pow(mut ref arena, x, two);
    let two_x_sq: i64 = sym_mul(mut ref arena, two, x_sq);
    let expr: i64 = sym_sub(mut ref arena, two_x_sq, eight);

    let roots: Vec<f64> = sym_solve_poly_le2(ref arena, expr, vid);
    assert (len(ref roots) as i64) == 2;
    let has_pos2: bool = close(roots[0], 2.0) || close(roots[1], 2.0);
    let has_neg2: bool = close(roots[0], 0.0 - 2.0) || close(roots[1], 0.0 - 2.0);
    assert has_pos2 && has_neg2;
    return 0;
}

#[test]
fn test_solve_equation_two_sided() -> i64 {
    // 2x + 3 = 7  ->  x = 2
    let larena: Vec<ExprNode> = sym_arena_new();
    let ltable: SymbolTable = symtab_new();
    let vid: i64 = symtab_intern(mut ref ltable, "x");
    let x: i64 = sym_var(mut ref larena, mut ref ltable, "x");
    let two: i64 = sym_num(mut ref larena, 2);
    let three: i64 = sym_num(mut ref larena, 3);
    let two_x: i64 = sym_mul(mut ref larena, two, x);
    let lhs: i64 = sym_add(mut ref larena, two_x, three);

    let rarena: Vec<ExprNode> = sym_arena_new();
    let rhs: i64 = sym_num(mut ref rarena, 7);

    let roots: Vec<f64> = sym_solve_equation_le2(ref larena, lhs, ref rarena, rhs, vid);
    assert (len(ref roots) as i64) == 1;
    assert close(roots[0], 2.0);
    return 0;
}

// Unrecognized shape (x^3) -- must return an explicit empty result, not
// a wrong-but-plausible-looking answer.
#[test]
fn test_solve_unrecognized_shape_returns_empty() -> i64 {
    let arena: Vec<ExprNode> = sym_arena_new();
    let table: SymbolTable = symtab_new();
    let vid: i64 = symtab_intern(mut ref table, "x");
    let x: i64 = sym_var(mut ref arena, mut ref table, "x");
    let three: i64 = sym_num(mut ref arena, 3);
    let expr: i64 = sym_pow(mut ref arena, x, three);

    let roots: Vec<f64> = sym_solve_poly_le2(ref arena, expr, vid);
    assert (len(ref roots) as i64) == 0;
    return 0;
}

// Degenerate: a pure constant (c1=c2=0) is neither "one root" nor a
// finite root list -- reports no roots either way (5=0 has none; 0=0
// has infinitely many, neither fits a Vec<f64> answer).
#[test]
fn test_solve_degenerate_constant_returns_empty() -> i64 {
    let arena: Vec<ExprNode> = sym_arena_new();
    let table: SymbolTable = symtab_new();
    let vid: i64 = symtab_intern(mut ref table, "x");
    let five: i64 = sym_num(mut ref arena, 5);

    let roots: Vec<f64> = sym_solve_poly_le2(ref arena, five, vid);
    assert (len(ref roots) as i64) == 0;
    return 0;
}

// Composed check: find f(x) = x^2 - 4x + 3's critical point by solving
// f'(x) = 0 (via sym_diff, v0.3.0), confirming v0.3.0 and v0.5.0 compose
// -- the critical point of a parabola a*x^2+b*x+c is x = -b/(2a) = 2.
#[test]
fn test_solve_composed_with_diff_finds_critical_point() -> i64 {
    let arena: Vec<ExprNode> = sym_arena_new();
    let table: SymbolTable = symtab_new();
    let vid: i64 = symtab_intern(mut ref table, "x");
    let x: i64 = sym_var(mut ref arena, mut ref table, "x");
    let two: i64 = sym_num(mut ref arena, 2);
    let four: i64 = sym_num(mut ref arena, 4);
    let three: i64 = sym_num(mut ref arena, 3);
    let x_sq: i64 = sym_pow(mut ref arena, x, two);
    let four_x: i64 = sym_mul(mut ref arena, four, x);
    let step1: i64 = sym_sub(mut ref arena, x_sq, four_x);
    let f: i64 = sym_add(mut ref arena, step1, three);

    let fprime: i64 = sym_diff(mut ref arena, f, vid);
    let roots: Vec<f64> = sym_solve_poly_le2(ref arena, fprime, vid);
    assert (len(ref roots) as i64) == 1;
    assert close(roots[0], 2.0);
    return 0;
}

fn main() -> i64 { return 0; }
