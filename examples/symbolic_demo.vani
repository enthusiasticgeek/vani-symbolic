// p(x) = 2x^3 - 3x^2 + x - 5, built, evaluated at four points, and
// printed -- the composed construction+eval+print check this package's
// build order calls for before considering a layer done (per
// vani-matrix's mat_eig_power precedent: a function passing every
// isolated test still broke once chained with another).
// Run with:  vanic run examples/symbolic_demo.vani

use "../src/lib.vani";

fn main() -> i64 {
    let arena: Vec<ExprNode> = sym_arena_new();
    let table: SymbolTable = symtab_new();

    // x^3 term: fresh sym_var call for x.
    let x_for_cube: i64 = sym_var(mut ref arena, mut ref table, "x");
    let three: i64 = sym_num(mut ref arena, 3);
    let x_cubed: i64 = sym_pow(mut ref arena, x_for_cube, three);
    let two_coef: i64 = sym_num(mut ref arena, 2);
    let term1: i64 = sym_mul(mut ref arena, two_coef, x_cubed);

    // x^2 term: a SECOND fresh sym_var call for x (same var_id as the
    // first, since symtab_intern dedups by name -- but a distinct arena
    // node).
    let x_for_square: i64 = sym_var(mut ref arena, mut ref table, "x");
    let two_exp: i64 = sym_num(mut ref arena, 2);
    let x_squared: i64 = sym_pow(mut ref arena, x_for_square, two_exp);
    let three_coef: i64 = sym_num(mut ref arena, 3);
    let term2: i64 = sym_mul(mut ref arena, three_coef, x_squared);

    // bare x term: REUSES x_for_cube's node index directly instead of
    // calling sym_var a third time -- the other valid pattern, and
    // arguably the more natural one when the same occurrence is meant.
    let term3: i64 = x_for_cube;

    let five: i64 = sym_num(mut ref arena, 5);

    let step1: i64 = sym_sub(mut ref arena, term1, term2); // 2x^3 - 3x^2
    let step2: i64 = sym_add(mut ref arena, step1, term3); // + x
    let poly: i64 = sym_sub(mut ref arena, step2, five);   // - 5

    // Evaluate at x = 0, 1, 2, -1 against hand-computed references:
    // p(0)=-5, p(1)=2-3+1-5=-5, p(2)=16-12+2-5=1, p(-1)=-2-3-1-5=-11.
    let v0: Vec<i64> = vec(0);
    let v1: Vec<i64> = vec(1);
    let v2: Vec<i64> = vec(2);
    let vm1: Vec<i64> = vec(0 - 1);

    assert sym_eval(ref arena, poly, ref v0) == (0 - 5);
    assert sym_eval(ref arena, poly, ref v1) == (0 - 5);
    assert sym_eval(ref arena, poly, ref v2) == 1;
    assert sym_eval(ref arena, poly, ref vm1) == (0 - 11);

    let printed: OwnedStr = sym_to_str(ref arena, ref table, poly);
    print "p(x) =";
    print printed;
    assert printed == "2*x^3 - 3*x^2 + x - 5";

    print "p(0), p(1), p(2), p(-1):";
    print i64_to_str(sym_eval(ref arena, poly, ref v0));
    print i64_to_str(sym_eval(ref arena, poly, ref v1));
    print i64_to_str(sym_eval(ref arena, poly, ref v2));
    print i64_to_str(sym_eval(ref arena, poly, ref vm1));

    return 0;
}
